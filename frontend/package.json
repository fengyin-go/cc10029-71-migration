{
  "name": "teach-diagnose-frontend",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "repoKind": "fullstack",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "vue-tsc --noEmit",
    "test": "vitest run",
    "typecheck:spec": "vue-tsc --noEmit -p tsconfig.spec.json",
    "postbuild": "node scripts/postbuild.mjs"
  },
  "dependencies": {
    "vue": "^3.4.21",
    "vue-router": "^4.3.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@vitejs/plugin-vue": "^5.0.4",
    "@vue/test-utils": "^2.4.6",
    "happy-dom": "^15.11.7",
    "typescript": "^5.4.3",
    "vite": "^5.2.6",
    "vitest": "^2.1.8",
    "vue-tsc": "^2.0.7"
  }
}
